<?xml version="1.0" encoding="utf-8"?>
<Container version="2">
  <Name>password-checker-web</Name>
  <Repository>hardly007/password-checker-web:latest</Repository>
  <Registry>https://hub.docker.com/r/hardly007/password-checker-web</Registry>
  <Network>bridge</Network>
  <MyIP></MyIP>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/JPetovello/password-checker-web/issues</Support>
  <Project>https://github.com/JPetovello/password-checker-web</Project>
  <Overview>A lightweight Flask web application that evaluates password strength using zxcvbn and generates high-entropy passphrases based on the official 7,776-word EFF Large Wordlist.</Overview>
  <Category>Security</Category>
  <WebUI>http://[IP]:[PORT:5000]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/JPetovello/unraid-templates/main/password-checker-web.xml</TemplateURL>
  <Icon></Icon>
  <Config Name="Web UI Port" Target="5000" Default="5000" Mode="tcp" Description="Port for accessing the web interface and API." Type="Port" Display="always" Required="true" Mask="false">5000</Config>
</Container>
