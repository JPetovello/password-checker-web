<?xml version="1.0"?>
<Container version="2">
  <Name>password-checker-web</Name>
  <Repository>hardly007/password-checker-web</Repository>
  <Registry>https://hub.docker.com/r/hardly007/password-checker-web</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/JPetovello/Unraid-templates/issues</Support>
  <Project>https://github.com/JPetovello/Unraid-templates</Project>
  <Overview>A Flask web application to check password strength using zxcvbn and generate high-entropy passphrases.</Overview>
  <Category>Security: Tools:Utilities</Category>
  <WebUI>http://[IP]:[PORT:5000]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/JPetovello/Unraid-templates/main/password-checker-web.xml</TemplateURL>
  <Config Name="Web Port" Target="5000" Default="5000" Mode="tcp" Description="The port the web UI listens on." Type="Port" Display="always" Required="true" Mask="false">5000</Config>
</Container>
